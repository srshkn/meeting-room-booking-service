# -------------------------------------------------------------------------
# Configuration prefix

CONFIG_PREFIX=

# -------------------------------------------------------------------------
# Server

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Options [ms, s, m, h]
SERVER_SHUTDOWN_TIMEOUT=10s

# -------------------------------------------------------------------------
# LOGGER

# Options [dev, local, prod]
LOGGER_FORMAT=dev

# -------------------------------------------------------------------------
# Database

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=MeetingRoomBookingService

DB_MAX_OPEN_CONNS=10
DB_MIN_OPEN_CONNS=2

# Options [ms, s, m, h]
DB_CONN_MAX_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

# -------------------------------------------------------------------------
# JWT

JWT_PATH_PRIVATE_KEY=/app/secrets/private.pem
JWT_PATH_PUBLIC_KEY=/app/secrets/public.pem

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=720h

JWT_ISSUER=my-service
JWT_AUDIENCE=my-api

# -------------------------------------------------------------------------
# CORS

CORS_ALLOWED_ORIGINS=http://localhost:3000

# [GET, POST, PUT, PATCH, DELETE, OPTIONS]
CORS_ALLOWED_METHODS=GET;POST;PUT;PATCH;DELETE;OPTIONS

# [Content-Type, Authorization
CORS_ALLOWED_HEADERS=Content-Type;Authorization

# [true, fasle]
CORS_ALLOW_CREDENTIALS=true
