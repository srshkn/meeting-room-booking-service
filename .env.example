# -------------------------------------------------------------------------
# Configuration prefix

CONFIG_PREFIX=

# -------------------------------------------------------------------------
# Server

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Options [ms, s, m, h]
SERVER_SHUTDOWN_TIMEOUT=10s

# -------------------------------------------------------------------------
# Database

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=MeetingRoomBookingService

DB_MAX_OPEN_CONNS=10
DB_MIN_OPEN_CONNS=2

# Options [ms, s, m, h]
DB_CONN_MAX_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
